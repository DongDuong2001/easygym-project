{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "easygym",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "changelog-sections": [
        { "type": "feat", "section": "Tính năng" },
        { "type": "fix", "section": "Sửa lỗi" },
        { "type": "perf", "section": "Hiệu năng" },
        { "type": "docs", "section": "Tài liệu", "hidden": true },
        { "type": "test", "section": "Test", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "chore", "section": "Việc vặt", "hidden": true },
        { "type": "refactor", "section": "Refactor", "hidden": true },
        { "type": "style", "section": "Style", "hidden": true }
      ]
    }
  }
}
