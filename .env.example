# Copy to .env and fill in. Never commit .env.

# Local (docker compose up -d):
DATABASE_URL=postgres://easygym:easygym@localhost:5433/easygym?sslmode=disable

# Supabase: Project Settings > Database > Connection string.
# For the API, use the transaction pooler (port 6543) and keep default_query_exec_mode=exec:
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&default_query_exec_mode=exec
# For migrate and seed, use the session pooler (port 5432) or the direct connection.

API_ADDR=:8080

# Used by the SvelteKit server to reach the Go API.
API_URL=http://localhost:8080

# Google sign-in tokens. Empty AUTH_JWKS_URL keeps /api/me and every /api/admin/* route closed (401).
# Supabase Auth: Project Settings > API > JWT keys; issuer https://<project-ref>.supabase.co/auth/v1, audience authenticated.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated
# Comma-separated emails that become admin on their first sign-in.
ADMIN_EMAILS=

# Uploaded images (relative to where the API runs). Back this folder up with the database.
FILES_DIR=files
